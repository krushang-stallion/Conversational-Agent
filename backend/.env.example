# Backend Server Port
PORT=8080

# Primary LLM Provider: 'openai' or 'gemini'
LLM_PROVIDER=openai

# OpenAI API Key (For ultra-fast tool calling and natural voice TTS)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Alternative)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash

# Deployed Remote MCP Server SSE Endpoint
REMOTE_MCP_SERVER_URL=https://stallion-mcp-server-test.onrender.com/sse
